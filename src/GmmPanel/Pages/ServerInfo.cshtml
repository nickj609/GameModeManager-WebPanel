@page "/server/{name}"
@model ServerInfoModel
@{
    ServerView view = Model.View;
    StatusSnapshot? s = view.Status;
    ViewData["Title"] = view.Name;
    // The link preview: what it's playing and who's on, with the map's picture
    if (s != null) ViewData["Description"] = $"{s.Mode.Label} · {s.Map.Label} · {s.Players}/{s.MaxPlayers}";
    if (s != null && Model.ArtFor(s.Map.Name) is string preview) ViewData["Image"] = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}{preview}";
    DateTimeOffset now = DateTimeOffset.UtcNow;
    var day = Model.Week.Where(w => w.At >= now.AddHours(-24)).ToList();
    int peakDay = day.Count == 0 ? 0 : day.Max(d => d.Players);
    int peakWeek = Model.Week.Count == 0 ? 0 : Model.Week.Max(d => d.Players);
    string? address = view.Online ? view.ConnectAddress : null;
    var roster = view.Online ? s?.Roster ?? new() : new();
    string? art = s == null ? null : Model.ArtFor(s.Map.Name);
}
<div class="eyebrow crumbs"><a href="/">@T("Servers")</a> &rsaquo; @T("Server")</div>

@* The header, as on the dashboard: the map's picture in a square, the server and what it's playing, then the buttons together *@
<div class="spot-banner info-banner" data-map="@(s?.Map.Name ?? "")">
    <partial name="_MapSquare" model="@((art, s?.Map.Label ?? ""))" />
    <div class="spot-title">
        <small><span class="ind @(view.Online ? "ok" : "bad")">@(view.Online ? F("Online for {0}", Format.Span(now - (view.OnlineSince ?? now))) : T("Offline"))</span></small>
        <h1>@view.Name</h1>
        @if (s?.Server?.Hostname is { Length: > 0 } host) { <div class="info-host">@host</div> }
        @if (s != null)
        {
            <div class="facts">
                <span><b>@s.Mode.Label</b></span>
                <span>@s.Map.Label@(s.NextMap != null ? " · " + F("next {0}", s.NextMap) : "")</span>
                <span>@F("{0} / {1} players", view.Online ? s.Players : 0, s.MaxPlayers)</span>
            </div>
        }
    </div>
    <div class="spot-actions">
        @if (address != null)
        {
            <a class="button primary" href="steam://connect/@address" title="@F("Opens CS2 and joins {0}", address)"><svg class="ic" aria-hidden="true"><use href="#i-play"/></svg>@T("Connect")</a>
        }
        else
        {
            <span class="button primary disabled" title="@T(view.Online ? "The server didn't report its public address" : "The server is offline")"><svg class="ic" aria-hidden="true"><use href="#i-play"/></svg>@T("Connect")</span>
        }
        @if (Model.CanManage)
        {
            <a class="button" href="/servers/@Uri.EscapeDataString(view.Name)"><svg class="ic" aria-hidden="true"><use href="#i-crosshair"/></svg>@T("Manage")</a>
        }
        @if (Model.FeatureOn("reports")) { <a class="button" href="/report?server=@Uri.EscapeDataString(view.Name)" title="@F("Report a player on {0}", view.Name)"><svg class="ic" aria-hidden="true"><use href="#i-flag"/></svg>@T("Report")</a> }
    </div>
</div>

@if (s == null)
{
    <p class="note">@T("This server hasn't reported in since the panel started.")</p>
}
else
{
    <div class="spot-grid">
        <section class="spot-live">
            <div class="group-title">@T("Who's on") <small>@roster.Count / @s.MaxPlayers</small></div>
            @if (roster.Count == 0)
            {
                <div class="empty">@T(view.Online ? "Nobody right now. Be the first." : "The server is offline.")</div>
            }
            else
            {
                bool board = roster.Any(p => p.Score != 0 || p.Ping != 0 || p.Kills != 0);
                if (board) { <div class="live-head"><span></span><span class="live-name">@T("Player")</span><span class="live-stat">K / D</span><span class="live-stat score">@T("Score")</span><span class="live-stat ping">@T("Ping")</span><span class="team"></span></div> }
                <div class="live-list">
                @foreach (RosterEntry p in roster.OrderBy(p => p.Team).ThenByDescending(p => p.Score).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase))
                {
                    string? avatar = Model.AvatarOf(p.SteamId);
                    <div class="live-row">
                        @if (avatar != null) { <img class="avatar small" src="@avatar" alt="" width="28" height="28" referrerpolicy="no-referrer"> }
                        else { <span class="avatar small letter">@(p.Name.Length > 0 ? char.ToUpperInvariant(p.Name[0]) : '?')</span> }
                        <span class="live-name">@if (Model.Staff) { <a href="/players/@p.SteamId">@p.Name</a> } else { <a href="/u/@p.SteamId">@p.Name</a> }</span>
                        @if (board) { <span class="live-stat" title="@T("Kills") / @T("Deaths")">@p.Kills / @p.Deaths</span><span class="live-stat score" title="@T("Score")">@p.Score</span><span class="live-stat ping" title="@T("Ping")">@p.Ping ms</span> } else { <span class="live-time">@(Model.Since.TryGetValue(p.SteamId, out DateTimeOffset since) ? Format.Span(now - since) : "")</span> }
                        <span class="team team-@p.Team.ToLowerInvariant()">@p.Team</span>
                    </div>
                }
                </div>
            }
        </section>
        <section>
            <div class="group-title">@T("Last 24 hours") <small>@F("peak {0}", peakDay)</small></div>
            @if (day.Count > 1) { @Graph.Players(day, now.AddHours(-24), now, 600, 100, "graph", F("Players over the last 24 hours, peak {0}", peakDay)) }
            else { <div class="empty">@T("Not enough history yet: the panel samples every 5 minutes.")</div> }
            <div class="group-title">@T("Last 7 days") <small>@F("peak {0}", peakWeek)</small></div>
            @if (Model.Week.Count > 1) { @Graph.Players(Model.Week, now.AddDays(-7), now, 600, 100, "graph", F("Players over the last 7 days, peak {0}", peakWeek)) }
            else { <div class="empty">@T("Not enough history yet.")</div> }
            @* The last maps played: the current one first, then how long each ran and its busiest moment *@
            <div class="group-title">@T("Recent maps")</div>
            @if (Model.Maps.Count == 0)
            {
                <div class="empty">@T("The panel notes each map change from now on.")</div>
            }
            else
            {
                <div class="map-log">
                    @foreach (var play in Model.Maps)
                    {
                        string? pic = Model.ArtFor(play.Map);
                        <div class="map-log-row">
                            @if (pic != null) { <img class="map-log-pic" src="@pic" alt="" loading="lazy"> } else { <span class="map-log-pic none"></span> }
                            <span class="map-log-name"><b>@play.Label</b> <small>@play.Mode</small></span>
                            <span class="map-log-when">@(play.End == null ? T("Now") : Format.Ago(play.Start))</span>
                            <span class="map-log-len">@Format.Span((play.End ?? now) - play.Start)</span>
                            <span class="map-log-peak" title="@T("Most players at once")">@F("peak {0}", play.Peak)</span>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
    @if (Model.Countries is { } countries) { <partial name="_Countries" model="countries" /> }
}
