@page "/site"
@model SiteModel
@{
    ViewData["Title"] = "Site settings";
    var look = Model.Look;
}
@* The panel admins' settings: the site's look, pictures, links and features for everyone, then the panel itself (admins,
   permissions, servers, Discord, retention, backup). Each person's own look in their browser is on Appearance. *@
<div class="page-title">
    <div class="eyebrow">Panel</div>
    <h1>Site settings</h1>
    <p>What everyone sees, and how the panel runs. Your own look is on <a href="/appearance">Appearance</a>.</p>
</div>
@if (Model.Message != null)
{
    <div class="banner @(Model.Failed ? "" : "ok")"><svg class="ic" aria-hidden="true"><use href="#i-@(Model.Failed ? "warning" : "ok")"/></svg><span>@Model.Message</span></div>
}
@if (Model.NewToken != null)
{
    <div class="snippet"><pre id="new-token">@Model.NewToken</pre><button type="button" class="small" data-copy="new-token">Copy</button></div>
    <p class="note">The token for @Model.NewTokenServer, shown once. Put it in <code>panel-secrets.json</code> as <code>"Token"</code>.</p>
}

@* One section at a time, picked in the rail (panel.js remembers it; a #section link opens it) *@
<div class="tab-body" data-tabkey="gmm.tab.site">
    <div class="manage">
        <nav class="rail" aria-label="Sections">
            @foreach (var group in SiteModel.Sections.GroupBy(s => s.Group))
            {
                <div class="rail-group">@group.Key</div>
                @foreach (var s in group)
                {
                    <button type="button" class="rail-item" data-tab="@s.Id"><svg class="ic"><use href="#i-@s.Icon"/></svg><span>@s.Label</span><u>&rsaquo;</u></button>
                }
            }
        </nav>
        <div class="panes">
<section class="pane" data-pane="look"><div class="pane-head"><span class="crumb">Look</span><h2>Site look</h2></div>
<form method="post" asp-page-handler="Site" enctype="multipart/form-data" class="site-form">
    <div class="site-grid">
        <label>Site name <small>The tab title, and the logo when there's no picture</small><input type="text" name="name" maxlength="40" value="@look.Name" placeholder="GameModeManager Panel"></label>
        <label>Subtitle <small>Under the logo</small><input type="text" name="sub" maxlength="40" value="@look.Sub" placeholder="GameModeManager"></label>
        <label class="wide">Footer text<input type="text" name="footer" maxlength="120" value="@look.Footer" placeholder="© and the year, after your site name"></label>
        @* The three pictures side by side, each with what's there now under its picker *@
        <div class="wide uploads">
            <div class="upload">
                <label>Header logo <small>PNG, JPEG, WebP or SVG, up to 512 KB. About 200 × 48</small><input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/svg+xml,.svg"></label>
                @if (Model.LogoUrl != null)
                {
                    <div class="logo-now">@if (Model.LogoSvg is { } svgNow) { <span class="logo-svg">@svgNow</span> } else { <img class="logo-img" src="@Model.LogoUrl" alt="Your logo"> }</div>
                    <label class="check"><input type="checkbox" name="removeLogo" value="true"> Remove it</label>
                }
                else { <span class="note">None: @(look.Name.Length > 0 ? "your site name" : "the built-in logo")</span> }
            </div>
            <div class="upload">
                <label>Footer logo <small>Optional, same types. About 160 × 20</small><input type="file" name="footerLogo" accept="image/png,image/jpeg,image/webp,image/svg+xml,.svg"></label>
                @if (Model.FooterLogoUrl != null)
                {
                    <div class="logo-now">@if (Model.FooterLogoSvg is { } footNow) { <span class="logo-svg foot-logo-svg">@footNow</span> } else { <img class="foot-logo" src="@Model.FooterLogoUrl" alt="Your footer logo"> }</div>
                    <label class="check"><input type="checkbox" name="removeFooterLogo" value="true"> Remove it</label>
                }
                else { <span class="note">None: the header logo</span> }
            </div>
            <div class="upload">
                <label>Favicon <small>Square PNG, ICO or SVG, up to 512 KB</small><input type="file" name="favicon" accept="image/png,image/x-icon,.ico,image/svg+xml,.svg"></label>
                @if (Model.FaviconUrl != null)
                {
                    <div class="logo-now"><img class="favicon-now" src="@Model.FaviconUrl" alt="Your favicon" width="32" height="32"></div>
                    <label class="check"><input type="checkbox" name="removeFavicon" value="true"> Remove it</label>
                }
                else { <span class="note">None: a white crosshair</span> }
            </div>
            <p class="note wide-note">An SVG takes the theme's colours: <code>currentColor</code> is the text colour and <code>class="accent"</code> the accent.</p>
        </div>
    </div>
    <div class="site-grid colours">
        @foreach (var (field, label, value, fallback) in new[]
        {
            ("accent", "Accent", look.Accent, "#d4801a"), ("warn", "Notifications", look.Warn, "#ef5350"), ("bars", "Header and footer", look.Bars, "#0a0a0c"),
            ("panel", "Panel", look.Panel, "#121214"), ("page", "Page behind", look.Page, "#121110"), ("notify", "Pop-ups", look.Notify, "#101013")
        })
        {
            <label class="colour">@label
                <span><input type="color" value="@(value.Length > 0 ? value : fallback)" data-colour-for="@field">
                <input type="text" name="@field" value="@value" maxlength="7" placeholder="@fallback" title="Empty: @fallback, the panel's own" spellcheck="false" pattern="#[0-9a-fA-F]{6}"></span></label>
        }
    </div>
    <p class="note">These colours are for the dark theme, so keep them dark; light mode uses only the accent and notifications colours. Unreadable colours aren't saved.</p>
    <div class="site-grid">
        <label>Theme <small>Each person can pick their own</small><select name="theme">
            @foreach (var (value, text) in new[] { ("dark", "Dark"), ("light", "Light"), ("auto", "Follow each visitor's device") })
            { <option value="@value" selected="@(SiteLook.ThemeOf(look.Theme) == value)">@text</option> }
        </select></label>
        <label>Pattern<select name="pattern">
            @foreach (string p in SiteLook.Patterns) { <option value="@p" selected="@(look.Pattern == p)">@(p switch { "none" => "None", "dots" => "Dots", "grid" => "Grid", _ => "Diagonal lines" })</option> }
        </select></label>
        <label>Pattern strength <small>1 (faint) to 20</small><input type="range" name="patternStrength" min="1" max="20" value="@look.PatternStrength"></label>
        <label>Corner rounding <small>0 (square) to 16</small><input type="range" name="radius" min="0" max="16" value="@look.Radius"></label>
        <label>Default background <small>Auto shows the map being played, else Dust II</small><select name="background">
            <option value="" selected="@(look.Background.Length == 0)">Auto</option>
            @foreach (var b in Model.OwnBackgrounds) { <option value="@b.Id" selected="@(look.Background == b.Id)">@b.Name@(b.Scene ? "" : " (yours)")</option> }
        </select></label>
        <label>Darken the background <small>0% shows the scene as it is</small><span class="range-row"><input type="range" name="dim" min="0" max="100" step="5" value="@look.Dim" data-percent="dim-out"><output id="dim-out">@look.Dim%</output></span></label>
        <label class="check"><input type="checkbox" name="motion" value="true" checked="@look.Motion"> Background motion</label>
    </div>
    <div class="site-grid">
        <label>Default language <small>For anyone who hasn't picked one</small><select name="language">
            <option value="" selected="@(look.Language.Length == 0)">Auto</option>
            @foreach (var (code, langName) in Lang.Languages) { <option value="@code" selected="@(look.Language == code)">@langName</option> }
        </select></label>
    </div>
    <div class="buttons">
        <button type="submit" class="primary">Save the site look</button>
        <button type="submit" name="reset" value="true" class="danger" data-confirm="The name, logo, footer, colours and pattern go back to the panel's own." data-confirm-title="Reset the site look?" data-confirm-yes="Reset" data-confirm-danger="true">Reset to default</button>
    </div>
</form>

</section>
<section class="pane" data-pane="backgrounds"><div class="pane-head"><span class="crumb">Pictures</span><h2>Backgrounds</h2></div>
<p class="note">Pictures or short videos (WebM, MP4), up to 25 MB. Name one after a map (de_dust2.jpg) to show it on that map. Use only pictures you may use.</p>
<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mod-form">
    <input type="hidden" name="kind" value="background">
    <label>Background <small>1920 × 1080 or larger, up to 25 MB</small><input type="file" name="file" required accept="image/png,image/jpeg,image/webp,video/webm,video/mp4"></label>
    <label>Display name <small>Shown in the picker</small><input type="text" name="title" maxlength="40" placeholder="Dust II at night"></label>
    <button type="submit" class="primary">Upload</button>
</form>
@foreach (var b in Model.OwnBackgrounds)
{
    string file = b.Id[4..];
    <div class="row bg-row">
        <span class="label">@b.Name <small>@file · @(b.Scene ? "CS2 menu scenery" : b.Kind == "video" ? "video" : "picture")</small></span>
        <form method="post" asp-page-handler="RenameBackground" class="bg-rename">
            <input type="hidden" name="name" value="@file">
            <input type="text" name="title" maxlength="40" value="@Model.DisplayName(file)" placeholder="@b.Name" aria-label="Display name for @file">
            <button type="submit" class="small">Rename</button>
        </form>
        <form method="post" asp-page-handler="DeleteFile">
            <input type="hidden" name="kind" value="background"><input type="hidden" name="name" value="@file">
            <button type="submit" class="small danger" data-confirm="@file is deleted from the panel's data folder." data-confirm-title="Delete @file?" data-confirm-yes="Delete" data-confirm-danger="true">Delete</button>
        </form>
    </div>
}
</section>
<section class="pane" data-pane="maps"><div class="pane-head"><span class="crumb">Pictures</span><h2>Map pictures</h2></div>
<p class="note">Square pictures for the server cards, named after the map, up to 2 MB.</p>
<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mod-form">
    <input type="hidden" name="kind" value="map">
    <label>Map<input type="text" name="map" required maxlength="80" placeholder="de_dust2" spellcheck="false"></label>
    <label>Picture <small>Square, about 512 × 512, up to 2 MB</small><input type="file" name="file" required accept="image/png,image/jpeg,image/webp"></label>
    <button type="submit" class="primary">Upload</button>
</form>
@{ var missing = Model.MissingPictures; }
@if (missing.Count > 0)
{
    <p class="note">Your servers' maps without a picture (click one to fill the map name): @foreach (string m in missing.Take(30)) { <button type="button" class="chip" data-fill-map="@m">@m</button> }@(missing.Count > 30 ? $" and {missing.Count - 30} more" : "")</p>
}
<div class="map-grid-head">
    <span class="group-sub">Map pictures · @Model.MapFiles.Count</span>
    <input type="search" class="map-filter" placeholder="Filter maps" aria-label="Filter map pictures" data-map-filter>
</div>
<div class="map-grid scroll">
    @foreach (string file in Model.MapFiles)
    {
        <figure class="map-thumb" data-name="@file.ToLowerInvariant()">
            <img src="/maps/@Uri.EscapeDataString(file)" alt="" loading="lazy">
            <figcaption>@System.IO.Path.GetFileNameWithoutExtension(file)</figcaption>
            <form method="post" asp-page-handler="DeleteFile">
                <input type="hidden" name="kind" value="map"><input type="hidden" name="name" value="@file">
                <button type="submit" class="thumb-delete" title="Delete @file" data-confirm="The picture for @System.IO.Path.GetFileNameWithoutExtension(file) is deleted." data-confirm-title="Delete it?" data-confirm-yes="Delete" data-confirm-danger="true"><svg class="ic" aria-hidden="true"><use href="#i-no"/></svg></button>
            </form>
        </figure>
    }
</div>

</section>
<section class="pane" data-pane="links"><div class="pane-head"><span class="crumb">Look</span><h2>Community links</h2></div>
<p class="note">Icons in the footer and phone menu. Each uses the accent unless you pick a colour.</p>
@for (int i = 0; i < Model.Links.Count; i++)
{
    var link = Model.Links[i];
    <div class="row">
        <span class="label"><svg class="ic link-@i" aria-hidden="true"><use href="#i-@link.Icon"/></svg> @link.Label <small>@link.Url</small></span>
        <form method="post" asp-page-handler="LinkColor" class="link-color">
            <input type="hidden" name="index" value="@i">
            <input type="color" name="color" value="@(link.Color.Length > 0 ? link.Color : Model.AccentColour)" aria-label="Colour for @link.Label">
            <button type="submit" class="small">Set</button>
            @if (link.Color.Length > 0) { <button type="submit" name="accent" value="1" class="small quiet">Accent</button> }
        </form>
        <form method="post" asp-page-handler="RemoveLink">
            <input type="hidden" name="index" value="@i">
            <button type="submit" class="small danger">Remove</button>
        </form>
    </div>
}
<form method="post" asp-page-handler="AddLink" class="mod-form">
    <label>Label<input type="text" name="label" maxlength="24" required placeholder="Discord"></label>
    <label>Address<input type="url" name="url" maxlength="300" required placeholder="https://discord.gg/..."></label>
    <label>Icon<select name="icon">@foreach (string icon in LinkEntry.Icons) { <option value="@icon">@(char.ToUpperInvariant(icon[0]) + icon[1..])</option> }</select></label>
    <button type="submit" class="primary">Add link</button>
</form>

@* The status widget and the JSON, for the community's website or a Discord bot *@
</section>
<section class="pane" data-pane="rules"><div class="pane-head"><span class="crumb">Features</span><h2>Rules</h2></div>
<p class="note">One rule per line; <code>## </code> starts a section. Markdown works: <code>**bold**</code>, <code>*italic*</code>, <code>[text](https://link)</code>. Leave it empty to hide the <a href="/rules">Rules</a> page.</p>
<form method="post" asp-page-handler="Rules" class="site-form">
    <div class="site-grid"><label class="wide">Rules <small>Up to @SiteModel.MaxRules.ToString("N0") characters</small>
        <textarea name="rules" rows="14" maxlength="@SiteModel.MaxRules" spellcheck="true" placeholder="## General&#10;Be respectful to other players.&#10;No cheats, scripts or exploits.&#10;## Chat&#10;No spam or advertising.">@Model.Store.Rules</textarea></label></div>
    <div class="buttons"><button type="submit" class="primary">Save rules</button></div>
</form>
</section>
<section class="pane" data-pane="widget"><div class="pane-head"><span class="crumb">Features</span><h2>Status widget</h2></div>
<p class="note">A server card for your website, updated every minute. <code>/status.json</code> has every server's status for bots.</p>
@{ string origin = $"{Request.Scheme}://{Request.Host}"; }
@{ int n = 0; }
@foreach (var server in Model.ServerNames)
{
    n++;
    <div class="embed-card">
        <div class="embed-head">
            <b>@server</b>
            <span class="embed-buttons">
                <a class="button small" href="/widget/@Uri.EscapeDataString(server)" target="_blank" rel="noopener">Preview</a>
                <button type="button" class="small" data-copy="embed-@n">Copy</button>
            </span>
        </div>
        <pre class="embed-code" id="embed-@n">&lt;iframe src="@origin/widget/@Uri.EscapeDataString(server)" width="420" height="100" style="border:0" title="@server"&gt;&lt;/iframe&gt;</pre>
    </div>
}
<div class="embed-card">
    <div class="embed-head">
        <b>Every server, as JSON</b>
        <span class="embed-buttons">
            <a class="button small" href="/status.json" target="_blank" rel="noopener">Open</a>
            <button type="button" class="small" data-copy="embed-json">Copy</button>
        </span>
    </div>
    <pre class="embed-code" id="embed-json">@origin/status.json</pre>
</div>

@* Features: the panel's own pages and parts; off hides them everywhere *@
</section>
<section class="pane" data-pane="integrations"><div class="pane-head"><span class="crumb">Features</span><h2>Features</h2></div>
<p class="note">Turn off what you don't use: its pages and buttons disappear, and its data is kept.</p>
<form method="post" asp-page-handler="Integrations" class="site-form">
    <div class="site-grid">
        @foreach (var (id, label, what) in Features.All)
        {
            <label class="check feature-check"><input type="checkbox" name="feature-@id" value="true" checked="@Features.On(Model.Store, id)"><span><b>@label</b><small>@what</small></span></label>
        }
    </div>
    <div class="buttons"><button type="submit" class="primary">Save features</button></div>
</form>

</section>
<section class="pane" data-pane="admins"><div class="pane-head"><span class="crumb">People</span><h2>Panel admins</h2></div>
<p class="note">Panel admins can do everything. Everyone else gets what their admin flags allow on each server.</p>
@foreach (AdminEntry admin in Model.Data.Admins.OrderBy(a => a.Name, StringComparer.OrdinalIgnoreCase))
{
    <div class="row">
        <span class="label">@admin.Name <small><a href="https://steamcommunity.com/profiles/@admin.SteamId" target="_blank" rel="noopener noreferrer">@admin.SteamId</a> · @(admin.Servers.Count == 0 ? "every server" : string.Join(", ", admin.Servers))</small></span>
        @if (admin.SteamId == Model.Admin.SteamId)
        {
            <span class="state on">You</span>
        }
        else
        {
            <form method="post" asp-page-handler="RemoveAdmin">
                <input type="hidden" name="steamId" value="@admin.SteamId">
                <button type="submit" class="small danger" data-confirm="@admin.Name stops being a panel admin. Their admin flags on the servers still count." data-confirm-title="Remove @admin.Name?" data-confirm-yes="Remove" data-confirm-danger="true">Remove</button>
            </form>
        }
    </div>
}
<form method="post" asp-page-handler="AddAdmin" class="mod-form">
    <label>SteamID64<input type="text" name="steamId" inputmode="numeric" pattern="7656119[0-9]{10}" maxlength="17" required placeholder="7656119..."></label>
    <label>Name<input type="text" name="name" maxlength="40" required></label>
    <label>Servers<input type="text" name="servers" maxlength="200" placeholder="Empty: every server"></label>
    <button type="submit" class="primary">Add panel admin</button>
</form>

@{ int outdated = Model.Data.Servers.Count(s => AgentVersion.Problem(Model.Find(s.Name)) != null); }
</section>
<section class="pane" data-pane="servers"><div class="pane-head"><span class="crumb">Servers</span><h2>Servers</h2></div>
@if (outdated > 0)
{
    <div class="banner"><svg class="ic" aria-hidden="true"><use href="#i-warning"/></svg><span>@outdated server@(outdated == 1 ? " runs" : "s run") an older GameModeManager than this panel expects (@AgentVersion.Expected). See below.</span></div>
}
@foreach (ServerEntry server in Model.Data.Servers.OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase))
{
    ServerView? view = Model.Find(server.Name);
    string? versionProblem = AgentVersion.Problem(view);
    <div class="row">
        @* The status dot with the name (as on the server tabs); everything else is in its Settings pop-up *@
        <span class="label"><span class="ind @(view?.Online == true ? "ok" : "bad")" title="@(view?.Online == true ? "Online" : "Offline")">@GmmPanel.Data.ServerNames.Label(server.Name)</span>
            <small>@(server.DisplayName.Length > 0 ? $"ID {server.Name} · " : "")@(view?.Connection?.Hello is { } hello ? $"GameModeManager {hello.GmmVersion}" : view?.Online == true ? "Online" : "Not connected yet")</small>
            @if (versionProblem != null) { <small class="version-warn">@versionProblem</small> }</span>
        <button type="button" class="small" data-dlg="gmm-@server.Name">Settings</button>
        <dialog class="dlg details-dlg ticket-dlg" id="gmm-@server.Name" aria-labelledby="gmm-@server.Name-title">
            <div class="dlg-head details-head"><span id="gmm-@server.Name-title">@GmmPanel.Data.ServerNames.Label(server.Name)</span><small class="mono">@server.Name</small></div>
            <div class="ticket-section">
                <div class="group-title">Display name</div>
                <form method="post" asp-page-handler="ServerLabel" class="inline-form">
                    <input type="hidden" name="server" value="@server.Name">
                    <input type="text" name="label" maxlength="@GmmPanel.Data.ServerNames.MaxLabel" value="@server.DisplayName" placeholder="@server.Name" aria-label="Display name">
                    <button type="submit" class="small primary">Save</button>
                </form>
                <p class="note">Shown on its tab, card and pages. Its ID, token and history stay the same.</p>
                <div class="group-title">GameModeManager.json</div>
                <p class="note">Replace the <code>Panel</code> block in its <code>GameModeManager.json</code>, then change the map. Its token stays the same.</p>
                <div class="snippet"><pre id="gmm-block-@server.Name">@GmmSettings.PanelBlock(Model.AgentUrl, server.Name)</pre><button type="button" class="small" data-copy="gmm-block-@server.Name">Copy</button></div>
            </div>
            <div class="details-links">
                <form method="post" asp-page-handler="Token">
                    <input type="hidden" name="server" value="@server.Name">
                    <button type="submit" class="small" data-confirm="@server.Name gets a new token and the old one stops working: it has to be put in its panel-secrets.json again." data-confirm-title="New token for @server.Name?" data-confirm-yes="New token">New token</button>
                </form>
                <form method="post" asp-page-handler="RemoveServer">
                    <input type="hidden" name="server" value="@server.Name">
                    <button type="submit" class="small danger" data-confirm="@server.Name can no longer connect to the panel." data-confirm-title="Remove @server.Name?" data-confirm-yes="Remove" data-confirm-danger="true">Remove</button>
                </form>
                <button type="button" class="small dlg-close" data-dlg-close>Close</button>
            </div>
        </dialog>
    </div>
}
<form method="post" asp-page-handler="Token" class="mod-form">
    <input type="hidden" name="add" value="true">
    <label>New server <small>Its display name, like Deathmatch #2</small><input type="text" name="label" maxlength="@GmmPanel.Data.ServerNames.MaxLabel" required placeholder="Deathmatch #2"></label>
    <label>ID <small>Optional. Can't be changed later</small><input type="text" name="server" maxlength="40" pattern="[A-Za-z0-9_\-]+" placeholder="Deathmatch-2"></label>
    <button type="submit" class="primary">Add server</button>
</form>
<p class="note">The <a href="/setup">setup page</a> walks through adding a server, with the GameModeManager settings to paste.</p>
<div class="group-title">Agent address</div>
<form method="post" asp-page-handler="AgentUrl" class="mod-form">
    <label>Where game servers connect <small>Moved domains? Change it, then paste each server's new Settings</small>
        <input type="text" name="url" maxlength="200" value="@Model.Data.AgentUrl" placeholder="@Model.AgentUrl"></label>
    <button type="submit" class="primary">Save</button>
</form>

</section>
<section class="pane" data-pane="permissions"><div class="pane-head"><span class="crumb">People</span><h2>Permissions</h2></div>
<p class="note">The admin flag each part needs. Settings, actions and plugin lists keep their own.</p>
<form method="post" asp-page-handler="Permissions" class="perm-form">
    @foreach (var area in PanelPermissions.Areas)
    {
        string current = PanelPermissions.Need(area.Id);
        <div class="row">
            <span class="label">@area.Label <small>@area.Help</small></span>
            <select name="flag-@area.Id" aria-label="@area.Label" class="narrow-select">
                @foreach (string flag in PanelPermissions.Choices.Append(current).Distinct())
                {
                    <option value="@flag" selected="@(flag == current)">@flag@(flag == area.Default ? " (default)" : "")</option>
                }
            </select>
        </div>
    }
    <button type="submit" class="primary">Save permissions</button>
</form>

</section>
<section class="pane" data-pane="discord"><div class="pane-head"><span class="crumb">Servers</span><h2>Discord</h2></div>
@{ var discord = Model.DiscordSettings; }
<p class="note">Posts to a Discord channel through its webhook (channel settings, Integrations, Webhooks). @(discord.Url.Length > 0 ? "A webhook is set; it isn't shown again." : "No webhook yet.")</p>
<form method="post" asp-page-handler="Discord" class="discord-form">
    <label>Webhook address<input type="url" name="url" maxlength="300" autocomplete="off" spellcheck="false" placeholder="@(discord.Url.Length > 0 ? "Set: type a new one to replace it" : "https://discord.com/api/webhooks/...")"></label>
    <label class="check"><input type="checkbox" name="servers" value="true" checked="@discord.Servers"> Server status: offline for 2 minutes, back online</label>
    <label class="check"><input type="checkbox" name="tickets" value="true" checked="@discord.Tickets"> New ban appeals and player reports</label>
    <label class="check"><input type="checkbox" name="actions" value="true" checked="@discord.Actions"> Staff actions on servers</label>
    <div class="buttons">
        <button type="submit" class="primary">Save</button>
        @if (discord.Url.Length > 0)
        {
            <button type="submit" name="test" value="1">Save and send a test</button>
            <button type="submit" name="remove" value="1" class="danger">Turn off</button>
        }
    </div>
</form>

@* How long the panel keeps its own records, and what they take now. A cleanup runs every 6 hours; "Save and clean up now"
   runs it at once. Plugins' own data (bans, ranks ...) is theirs, not the panel's. *@
</section>
<section class="pane" data-pane="retention"><div class="pane-head"><span class="crumb">Data</span><h2>Retention</h2></div>
@{
    var keep = Model.Retention;
    static string Size(long bytes) => bytes < 1024 * 1024 ? $"{Math.Max(1, bytes / 1024)} KB" : $"{bytes / 1024.0 / 1024:0.#} MB";
    static string Days(int d) => d == 0 ? "Keep it all" : d % 365 == 0 ? $"{d / 365} year{(d == 365 ? "" : "s")}" : $"{d} days";
}
<p class="note">How long the panel keeps its own records. Plugins' data isn't touched.</p>
<form method="post" asp-page-handler="Retention" class="site-form">
    <div class="site-grid">
        @foreach (var (field, label, help, value, path) in new[]
        {
            ("audit", "Audit log", "Sign-ins, refusals and every command", keep.AuditDays, "audit.jsonl"),
            ("chat", "Chat log", "Game chat, for reports", keep.ChatDays, ""),
            ("counts", "Player counts", "The graphs (chat, counts and players: history folder)", keep.CountDays, "history"),
            ("players", "Player history", "Players not seen for this long are forgotten", keep.PlayerDays, ""),
            ("tickets", "Answered appeals and reports", "Open ones are always kept", keep.TicketDays, "tickets.json"),
            ("logs", "The panel's log files", "data/logs, one file a day", keep.LogDays, "logs")
        })
        {
            <label>@label <small>@help@(path.Length > 0 ? $" · {Size(Model.SizeOf(path))} now" : "")</small>
                <select name="@field">@foreach (int d in Retention.Choices) { <option value="@d" selected="@(d == value)">@Days(d)</option> }</select></label>
        }
    </div>
    <div class="buttons">
        <button type="submit" class="primary">Save</button>
        <button type="submit" name="clean" value="1" data-confirm="Records older than these are deleted now. This can't be undone." data-confirm-title="Clean up now?" data-confirm-yes="Clean up" data-confirm-danger="true">Save and clean up now</button>
    </div>
</form>

@* Backup: settings and records as one zip, and back (for a new machine, or the Pi) *@
</section>
<section class="pane" data-pane="backup"><div class="pane-head"><span class="crumb">Data</span><h2>Backup</h2></div>
<p class="note">Settings and records in one zip. Sign-in keys aren't included, and the Discord webhook only if you tick it.</p>
<form method="get" action="/site" class="audit-export">
    <input type="hidden" name="handler" value="Backup">
    <label class="check"><input type="checkbox" name="history" value="true" checked> Player history and chat</label>
    <label class="check"><input type="checkbox" name="media" value="true" checked> Logo, pictures and backgrounds</label>
    <label class="check"><input type="checkbox" name="secrets" value="true"> Discord webhook</label>
    <button type="submit" class="small primary">Download a backup</button>
</form>
<form method="post" asp-page-handler="Restore" enctype="multipart/form-data" class="audit-export">
    <label>Restore <input type="file" name="file" accept=".zip,application/zip" required></label>
    <button type="submit" class="small danger" data-confirm="The backup's files replace the ones here. What's here now is kept as data\before-restore-<time>.zip first." data-confirm-title="Restore this backup?" data-confirm-yes="Restore" data-confirm-danger="true">Restore</button>
</form>
</section>
        </div>
    </div>
</div>
