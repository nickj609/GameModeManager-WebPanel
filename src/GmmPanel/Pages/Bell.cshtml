@page "/bell"
@model BellModel
@{ Layout = null; }
@* The bell: a small menu of the latest notices (each opens where it's about) and, for staff, what's waiting. Opening it
   marks them read (panel.js); the every-minute refresh waits while it's open. *@
@{
    int open = Math.Max(0, Model.Appeals) + Math.Max(0, Model.Reports);
    int count = Model.Unread + open;
    string title = count == 0 ? T("Nothing new") : F("{0} new", count);
}
<details class="bell-menu" data-bell>
    <summary class="head-link bell @(count > 0 ? "on" : "")" title="@title" aria-label="@title"><svg class="ic" aria-hidden="true"><use href="#i-bell"/></svg>@if (count > 0) { <span class="bell-count">@(count > 99 ? "99+" : count)</span> }</summary>
    <div class="bell-list" role="menu">
        <div class="bell-head">@T("Notifications")</div>
        @if (Model.Reports > 0) { <a class="notice warn" role="menuitem" href="/moderate#reports"><svg class="ic" aria-hidden="true"><use href="#i-flag"/></svg><span class="notice-text">@T("Open reports"): @Model.Reports</span></a> }
        @if (Model.Appeals > 0) { <a class="notice warn" role="menuitem" href="/moderate#appeals"><svg class="ic" aria-hidden="true"><use href="#i-appeal"/></svg><span class="notice-text">@T("Open appeals"): @Model.Appeals</span></a> }
        @foreach (var n in Model.Items)
        {
            string icon = n.Kind switch { "ban" => "ban", "mute" => "mute", "warn" => "warning", "kick" => "no", "role" => "shield", "ticket" => "appeal", _ => "ok" };
            string tone = n.Kind is "ban" or "mute" or "warn" or "kick" ? "bad" : n.Kind is "ended" or "role" ? "ok" : "";
            <a class="notice @(n.Read ? "" : "new") @tone" role="menuitem" href="@n.Link">
                <svg class="ic" aria-hidden="true"><use href="#i-@icon"/></svg>
                <span class="notice-text">@GmmPanel.Data.Notices.Show(n)</span>
                <span class="time">@Format.Ago(n.At)</span>
            </a>
        }
        @if (Model.Items.Count == 0 && open == 0) { <div class="bell-empty">@T("Nothing yet. You'll see bans, mutes, roles and answers here.")</div> }
    </div>
</details>
