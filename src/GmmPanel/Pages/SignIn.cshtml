@page "/signin"
@model SignInModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["Narrow"] = true;
}
<h2 class="menu-heading">@T("Sign in")</h2>
<div class="center-box">
    <p>@T("Sign in with Steam. Server admins see what their admin flags allow; everyone else sees their own profile.")</p>
    @if (Model.Failed)
    {
        <p class="note">@T("Steam didn't finish the sign-in. Try again.")</p>
    }
    <form method="post">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
        <button class="primary big steam" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-9.96 9.1l5.36 2.22a2.83 2.83 0 0 1 1.6-.5l2.4-3.47v-.05a3.79 3.79 0 1 1 3.79 3.79h-.09l-3.42 2.44a2.84 2.84 0 0 1-5.63.56L2.4 14.7A10 10 0 1 0 12 2zm-4.28 15.17-1.23-.51a2.13 2.13 0 1 0 1.17-2.9l1.27.53a1.57 1.57 0 1 1-1.21 2.88zM17.97 9.07a2.53 2.53 0 1 0-2.52 2.53 2.53 2.53 0 0 0 2.52-2.53zm-4.42 0a1.9 1.9 0 1 1 1.9 1.9 1.9 1.9 0 0 1-1.9-1.9z"/></svg>
            @T("Sign in through Steam")
        </button>
    </form>
    @if (Model.DevSignIn != null)
    {
        <form method="post" asp-page-handler="Dev">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
            <div class="dev-row"><input type="text" name="steamId" value="@Model.DevSignIn" maxlength="17" inputmode="numeric" aria-label="SteamID64"><button type="submit">Development sign-in</button></div>
        </form>
        <p class="note">Development only, from this machine. Never run Development behind the tunnel.</p>
    }
</div>
