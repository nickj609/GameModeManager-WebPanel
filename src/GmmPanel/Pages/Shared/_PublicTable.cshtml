@model PublicListModel
@{
    CommandResult? result = Model.Result;
    DataPage? data = result?.Data;
    int pages = data == null ? 1 : Math.Max(1, (data.Total + data.PageSize - 1) / data.PageSize);
    ViewData["Details"] = Model is BansModel;   // Bans and mutes: a Details pop-up per row
    ViewData["Board"] = Model is StatsModel;    // Leaderboards: even columns
}
@if (result == null || !result.Ok || data == null)
{
    <div class="empty">@(result?.Message ?? T("Nothing to show yet."))</div>
}
else if (data.Rows.Count == 0)
{
    <div class="empty">@((Model.Search ?? "").Length > 0 ? F("Nothing matches \"{0}\".", Model.Search) : T("Nothing here."))</div>
}
else
{
    <partial name="_Rows" model="data" />
    <div class="pager">
        <span>@F("{0} in all · page {1} of {2}", data.Total.ToString("N0"), data.Page, pages)</span>
        <button type="button" class="small" @(data.Page > 1 ? "" : "disabled") hx-get="@Model.Path?handler=List&amp;show=@Model.Current.Id&amp;p=@(data.Page - 1)&amp;q=@Uri.EscapeDataString(Model.Search ?? "")" hx-target="#public-list" hx-swap="innerHTML">@T("Previous")</button>
        <button type="button" class="small" @(data.Page < pages ? "" : "disabled") hx-get="@Model.Path?handler=List&amp;show=@Model.Current.Id&amp;p=@(data.Page + 1)&amp;q=@Uri.EscapeDataString(Model.Search ?? "")" hx-target="#public-list" hx-swap="innerHTML">@T("Next")</button>
    </div>
}
