@model ServerModel
@{
    ServerView view = Model.View;
    StatusSnapshot s = view.Status!;
    bool live = view.Online;
    bool owner = Model.Access.Has(PanelPermissions.Need("plugins"));   // Load, unload and reload: @css/root by default, as css_plugins wants
    bool cvar = Model.Access.Has(PanelPermissions.Need("server"));
    string post = $"/servers/{Uri.EscapeDataString(view.Name)}?handler=Command";
    string disabled = live && s.Server != null && cvar ? "" : "disabled";
    const string Outdated = "This server's GameModeManager is older than the panel: update it to see this.";
}
@* The Admin page: the server itself, as CS2-SimpleAdmin's Server section and plugin manager offer it *@

@* ---------- Server ---------- *@
<section class="pane on" data-pane="server">
    <div class="pane-head"><h2>Server</h2></div>
    @if (s.Server == null)
    {
        <div class="empty">@Outdated</div>
    }
    else
    {
        <p class="note">Lasts until the server restarts or a cfg changes it.</p>
        <form hx-post="@post" hx-target="#toasts" hx-swap="beforeend">
            <div class="row stack">
                <span class="label">Hostname <small>The name in the server browser</small></span>
                <input type="text" name="value" value="@s.Server.Hostname" maxlength="64" required aria-label="Hostname" @disabled>
                <button type="submit" name="command" value="set_hostname" @disabled>Set</button>
            </div>
        </form>
        @foreach (var team in new[] { (Key: "ct", Label: "CT team name", Value: s.Server.TeamCt), (Key: "t", Label: "T team name", Value: s.Server.TeamT) })
        {
            <form hx-post="@post" hx-target="#toasts" hx-swap="beforeend">
                <input type="hidden" name="team" value="@team.Key">
                <div class="row stack">
                    <span class="label">@team.Label <small>@(team.Key == "ct" ? "mp_teamname_1" : "mp_teamname_2"). Empty shows the default</small></span>
                    <input type="text" name="value" value="@team.Value" maxlength="32" aria-label="@team.Label" placeholder="@(team.Key == "ct" ? "Counter-Terrorists" : "Terrorists")" @disabled>
                    <button type="submit" name="command" value="set_teamname" @disabled>Set</button>
                </div>
            </form>
        }
        <div class="row">
            <span class="label">Connect address <small>@(view.ConnectAddress == null ? "Set Panel.PublicAddress in GameModeManager.json" : s.Server.Address == null ? "Guessed; set Panel.PublicAddress if it's wrong" : "What players type after connect")</small></span>
            @if (view.ConnectAddress != null)
            {
                <code class="addr">@view.ConnectAddress</code>
                <a class="button" href="steam://connect/@view.ConnectAddress"><svg class="ic" aria-hidden="true"><use href="#i-play"/></svg>Connect</a>
            }
        </div>
    }
</section>


@* ---------- Plugins: CounterStrikeSharp's, like SimpleAdmin's plugin manager, with what GameModeManager does with each ---------- *@
@{
    // GameModeManager's integrations, matched to the plugin folder they belong to. The rest (not installed, or not a plugin
    // like the Workshop addon) are listed under the plugins.
    var folderOf = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) { ["PanoramaMenuManager"] = "MenuManagerCore" };
    IntegrationInfo? IntegrationFor(PluginInfo plugin) => s.Integrations.FirstOrDefault(i =>
        (folderOf.GetValueOrDefault(i.Name) ?? i.Name).Equals(plugin.Name, StringComparison.OrdinalIgnoreCase)
        || i.Name.Equals(plugin.Module, StringComparison.OrdinalIgnoreCase));
    var others = s.Integrations.Where(i => s.Plugins == null || !s.Plugins.Any(p => IntegrationFor(p) == i)).ToList();
}
<section class="pane" data-pane="plugins">
    <div class="pane-head"><h2>Plugins</h2></div>
    @if (s.Plugins == null)
    {
        <div class="empty">@Outdated</div>
    }
    else
    {
        <p class="note">@(owner ? "Lasts until the server restarts. Harmony plugins (the PMM bridges) need a full restart." : "Needs @css/root.")</p>
        <div class="scroll">
        @foreach (PluginInfo plugin in s.Plugins.OrderBy(p => p.State switch { "loaded" => 0, "loading" => 1, "unloaded" => 2, "notloaded" => 3, _ => 4 })
            .ThenBy(p => p.Module.Length > 0 ? p.Module : p.Name, StringComparer.OrdinalIgnoreCase))
        {
            bool loaded = plugin.State == "loaded";
            IntegrationInfo? integration = IntegrationFor(plugin);
            // A web address in the description becomes the link icon after the version; the folder shows on hover
            var site = System.Text.RegularExpressions.Regex.Match(plugin.Description + " " + plugin.Author, @"https?://[^\s)]+");
            string Strip(string text) => site.Success ? System.Text.RegularExpressions.Regex.Replace(text.Replace(site.Value, ""), @"\s*\(\s*\)|\s{2,}", " ").Trim(' ', '·', '-', ':') : text;
            string about = Strip(plugin.Description), author = Strip(plugin.Author);
            string folder = plugin.Module.Length > 0 && plugin.Module != plugin.Name ? $"plugins/{plugin.Name}" : "";
            <div class="row plugin-row">
                <span class="label" title="@(folder.Length > 0 ? folder : null)">@(plugin.Module.Length > 0 ? plugin.Module : plugin.Name)
                    @if (plugin.Version.Length > 0) { <span class="ver">@plugin.Version</span> }
                    @if (site.Success) { <a class="plugin-site" href="@site.Value" target="_blank" rel="noopener noreferrer" title="@site.Value" aria-label="Project page"><svg class="ic" aria-hidden="true"><use href="#i-globe"/></svg></a> }
                    @* Only a plugin that isn't running gets a status: a list of "Loaded" said nothing *@
                    @switch (plugin.State)
                    {
                        case "loaded": break;
                        case "loading": <span class="ind warn plugin-state">Loading</span> break;
                        case "unloaded": <span class="ind bad plugin-state">Unloaded</span> break;
                        case "disabled": <span class="ind off plugin-state">Disabled</span> break;
                        default: <span class="ind off plugin-state">Not loaded</span> break;
                    }
                    <small>@(author.Length > 0 ? $"by {author}" : "")@(author.Length > 0 && about.Length > 0 ? " · " : "")@about</small>
                    @if (integration != null)
                    {
                        <small class="gmm-uses @(loaded ? "" : "idle")" title="@(loaded && integration.Detail.Length > 0 ? integration.Detail : null)"><svg class="ic" aria-hidden="true"><use href="#i-@(loaded ? "ok" : "no")"/></svg>@(loaded ? "Used by GameModeManager" : "GameModeManager works with it once it's loaded")</small>
                    }
                </span>
                @* Bare icons in a fixed column, so every row's right edge lines up (GameModeManager's own row has none) *@
                <span class="plugin-acts">
                @if (owner && !plugin.Protected)
                {
                    @* One form per button: a submit button named "action" sent its value twice *@
                    foreach (var (verb, label, icon, question) in loaded
                        ? new[] { ("reload", "Reload", "refresh", $"CounterStrikeSharp unloads {plugin.Name} and loads it again. Its players' state may reset."),
                                  ("unload", "Unload", "no", $"{plugin.Name} stops until it's loaded again or the server restarts.") }
                        : plugin.State == "disabled"
                        ? new[] { ("load", "Load", "play", $"{plugin.Name} runs from plugins/disabled until the server restarts. To load it on every start, move its folder out of disabled.") }
                        : new[] { ("load", "Load", "play", "") })
                    {
                        <form hx-post="@post" hx-target="#toasts" hx-swap="beforeend">
                            <input type="hidden" name="command" value="plugin">
                            <input type="hidden" name="plugin" value="@plugin.Name">
                            <input type="hidden" name="action" value="@verb">
                            <button type="submit" class="plugin-act @(verb == "unload" ? "unload" : "")" title="@label" aria-label="@label @plugin.Name" @(live ? "" : "disabled")
                                    data-confirm="@(question.Length > 0 ? question : null)" data-confirm-title="@label @plugin.Name?" data-confirm-yes="@label" data-confirm-danger="@(verb == "unload" ? "true" : null)"><svg class="ic" aria-hidden="true"><use href="#i-@icon"/></svg></button>
                        </form>
                    }
                }
                </span>
            </div>
        }
        @if (others.Count > 0)
        {
            <div class="group-title">GameModeManager also works with</div>
            @foreach (IntegrationInfo other in others)
            {
                <div class="row"><span class="label">@other.Name <small>@other.Detail</small></span>
                    @if (other.Found) { <span class="found ok"><svg class="ic" aria-hidden="true"><use href="#i-ok"/></svg>Found</span> }
                    else { <span class="found"><svg class="ic" aria-hidden="true"><use href="#i-no"/></svg>Not installed</span> }
                </div>
            }
        }
        </div>
    }
</section>
